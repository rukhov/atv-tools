            ],
            "stopAtEntry": false,
            "cwd": "C:/Users/rukho/radioconda",
            "environment": 
                [
                    {"name": "PATH", "value": "C:/Users/rukho/radioconda/pkgs/gnuradio-core-3.10.12.0-py312h509acc3_1/Library/bin;${workspaceFolder}/build/bin/Release;${workspaceFolder}/build/src/gr-ATV/test_modules/gnuradio/ATV;C:/Users/rukho/radioconda/Library/bin;%PATH%"}, 
