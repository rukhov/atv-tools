            "name": "Windows GNURADIO editor - Release",
            "type": "cppvsdbg",
            "request": "launch",
            "windows": {},
            "program": "C:/Users/rukho/radioconda/python.exe",
            //"program": "C:/Users/rukho/radioconda/Library/bin/gnuradio-companion.exe",
            //"program": "C:/usr/tools/depends-1.1-x64/DependenciesGui.exe",
            "args": [
